{
  "extends": "@mate-academy/students-ts-config",
  "include": [
    "src",
    "vite.config.ts",
    "cypress.config.ts",
    "src/vite-env.d.ts"
  ],
  "compilerOptions": {
    "sourceMap": false,
    "types": ["node", "cypress"],
    "jsx": "react-jsx",
    "baseUrl": "./src",
    "paths": {
      "@/*": ["./*"]
    },
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "moduleResolution": "node"
  },
  "exclude": ["node_modules"]
}
